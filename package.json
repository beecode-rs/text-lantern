{
	"name": "text-lantern",
	"version": "0.1.0",
	"description": "Text Lantern — a Handy-inspired menu-bar reader that speaks the selected text with Piper TTS.",
	"license": "MIT",
	"author": "milosbugarinovic",
	"type": "module",
	"imports": {
		"#packageJson": "./package.json",
		"#src/*": "./src/*"
	},
	"main": "./out/main/index.js",
	"scripts": {
		"build": "electron-vite build",
		"clean-app-cache": "node resource/script/clean-app-cache.cjs",
		"dev": "electron-vite dev",
		"dist:linux": "electron-vite build && electron-builder --linux --publish never",
		"dist:mac": "electron-vite build && electron-builder --mac --publish never",
		"dist:win": "electron-vite build && electron-builder --win --publish never",
		"lint": "pnpm run lint:prettier && pnpm run lint:eslint && pnpm run lint:json",
		"lint-fix": "pnpm run lint-fix:prettier && pnpm run lint-fix:eslint && pnpm run lint-fix:json",
		"lint-fix:eslint": "eslint ./ --fix",
		"lint-fix:json": "jsonsort -t *.json '!./node_modules' '!./**/.env*'",
		"lint-fix:prettier": "prettier --write '{**/*,*}.{js,ts,jsx,tsx,cjs,cts,mjs,mts,html}'",
		"lint:eslint": "eslint ./ --quiet --no-error-on-unmatched-pattern",
		"lint:json": "pnpm run lint-fix:json -c",
		"lint:prettier": "prettier --check '{**/*,*}.{js,ts,jsx,tsx,cjs,cts,mjs,mts,html}'",
		"pack:dir": "electron-vite build && electron-builder --dir --publish never",
		"postinstall": "node resource/script/install-electron.cjs",
		"preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_execpath||'')){console.error('This project uses pnpm only. Run: pnpm install');process.exit(1)}\"",
		"preview": "electron-vite preview",
		"release:major": "pnpm version major && git push origin HEAD --follow-tags",
		"release:minor": "pnpm version minor && git push origin HEAD --follow-tags",
		"release:patch": "pnpm version patch && git push origin HEAD --follow-tags",
		"start": "electron-vite preview",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"typecheck:node": "tsc -p tsconfig.node.json --noEmit",
		"typecheck:web": "tsc -p tsconfig.web.json --noEmit"
	},
	"dependencies": {
		"kokoro-js": "^1.2.1"
	},
	"devDependencies": {
		"@beecode/msh-app-boot": "^2.0.2",
		"@beecode/msh-env": "^2.0.3",
		"@beecode/msh-logger": "^2.0.2",
		"@beecode/msh-util": "^3.0.1",
		"@eslint/js": "^9.39.5",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^5.2.0",
		"dotenv": "^17.4.2",
		"electron": "^43.4.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-no-loops": "^0.4.0",
		"eslint-plugin-no-only-tests": "^3.4.0",
		"eslint-plugin-sort-keys-fix": "^1.1.2",
		"globals": "^17.11.0",
		"json-sort-cli": "^4.1.3",
		"lucide-react": "^1.31.0",
		"prettier": "^3.9.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^4.3.3",
		"tinyld": "^1.3.4",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.67.0",
		"vite": "^7.3.6",
		"zustand": "^5.0.14"
	},
	"packageManager": "pnpm@10.23.0",
	"productName": "Text Lantern"
}
